<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!-- Suppress false positives for dev dependencies -->
  <suppress>
    <notes>Dev dependency only — not used in production</notes>
    <packageUrl regex="true">^pkg:npm/nodemon@.*$</packageUrl>
    <cvssBelow>9</cvssBelow>
  </suppress>

  <suppress>
    <notes>ESLint dev dependency</notes>
    <packageUrl regex="true">^pkg:npm/eslint.*@.*$</packageUrl>
    <cvssBelow>9</cvssBelow>
  </suppress>
</suppressions>
